# Copy this file to .env and fill in your values

# Snowflake Connection Settings
SNOWFLAKE_ACCOUNT=your_account_identifier
SNOWFLAKE_USER=your_username
SNOWFLAKE_WAREHOUSE=CONTENT_REC_WH
SNOWFLAKE_DATABASE=CONTENT_REC_DEMO
SNOWFLAKE_SCHEMA=FEATURES
SNOWFLAKE_ROLE=CONTENT_REC_ROLE

# Authentication (choose one)
# Option 1: PAT (Programmatic Access Token) - Recommended
SNOWFLAKE_TOKEN=your_pat_token

# Option 2: Password (not recommended for production)
# SNOWFLAKE_PASSWORD=your_password

# Application Settings
USE_MOCK=true
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# API Settings
API_HOST=0.0.0.0
API_PORT=8000
