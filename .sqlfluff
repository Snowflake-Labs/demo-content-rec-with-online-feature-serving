[sqlfluff]
# Snowflake dialect
dialect = snowflake

# Exclude rules that are too strict or don't work well with Snowflake ML syntax
# LT01: Unnecessary trailing whitespace
# LT02: Expected indent
# LT05: Line too long (handled separately)
# AM04: Query produces an unknown number of columns
# CP02: Capitalisation (identifiers) - mixed case is common
# RF04: Keywords as identifiers - some are valid in Snowflake
exclude_rules = LT02, LT05, AM04, CP02, RF04

# Max line length
max_line_length = 120

# Indentation
[sqlfluff:indentation]
indent_unit = space
tab_space_size = 4
indented_joins = False
indented_ctes = False
indented_using_on = True
indented_on_contents = True

[sqlfluff:layout:type:comma]
line_position = trailing

# Keywords should be uppercase
[sqlfluff:rules:capitalisation.keywords]
capitalisation_policy = upper

# Functions should be uppercase
[sqlfluff:rules:capitalisation.functions]
capitalisation_policy = upper

# Literals should be uppercase (TRUE, FALSE, NULL)
[sqlfluff:rules:capitalisation.literals]
capitalisation_policy = upper

# Types should be uppercase
[sqlfluff:rules:capitalisation.types]
capitalisation_policy = upper
