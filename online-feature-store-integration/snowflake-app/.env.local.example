# Copy this file to .env.local and edit as needed.
#   cp .env.local.example .env.local
#
# Option 1 (recommended): use a named connection from ~/.snowflake/connections.toml
# SNOWFLAKE_CONNECTION_NAME=my_connection

# Option 2: provide credentials directly (overrides connections.toml)
# SNOWFLAKE_ACCOUNT=myaccount
# SNOWFLAKE_ACCOUNT_URL=https://myaccount.snowflakecomputing.com
# SNOWFLAKE_USER=myuser
# SNOWFLAKE_PASSWORD=mypassword
# SNOWFLAKE_WAREHOUSE=my_wh
# SNOWFLAKE_DATABASE=my_db
# SNOWFLAKE_ROLE=my_role

# Inference endpoint for the model service (USER_EMBEDDING_SERVICE)
# Local dev / external access: use the public ingress URL
#   Obtain with: SELECT SYSTEM$GET_SERVICE_STATUS('USER_EMBEDDING_SERVICE')
#   or: snow spcs service list-endpoints USER_EMBEDDING_SERVICE
# NEXT_PUBLIC_INFERENCE_ENDPOINT=https://<service-id>-<account>.snowflakecomputing.app
#
# SPCS internal (when deployed via snow app deploy): use the internal DNS name
#   Obtain with: DESCRIBE SERVICE USER_EMBEDDING_SERVICE  (dns_name column)
# INFERENCE_INTERNAL_ENDPOINT=http://<service>.svc.snowflakecomputing.internal:5000

# PAT token for authenticating to the inference endpoint (local dev only)
# Generate at: Snowsight → Settings → Developer → Programmatic Access Tokens
# SNOWFLAKE_PAT=<YOUR_PAT_TOKEN>
